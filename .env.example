# --- LLM (any LangChain "provider:model" string works; default uses OpenAI) ---
OPENAI_API_KEY=sk-...
LLM_MODEL=openai:gpt-4o-mini

# --- Linkup web search ---
LINKUP_API_KEY=your-linkup-key
LINKUP_DEPTH=standard          # fast | standard | deep

# --- SendGrid email ---
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=verified-sender@yourdomain.com

# --- Pipeline tuning ---
MAX_STARTUPS=8                 # max startups the discovery agent returns
DEEP_DIVE_CONCURRENCY=5        # parallel deep-dive agents

# --- Frontend -> backend URL ---
BACKEND_URL=http://localhost:8000
