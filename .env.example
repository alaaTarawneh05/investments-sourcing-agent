# --- LLM (any LangChain "provider:model" string works) ---
# FREE (default): Groq - key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-key
LLM_MODEL=groq:llama-3.3-70b-versatile

# FREE alternative: Google Gemini - key from https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-gemini-key
# LLM_MODEL=google_genai:gemini-3.6-flash

# Paid option: OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=openai:gpt-4o-mini

# --- Linkup web search ---
LINKUP_API_KEY=your-linkup-key
LINKUP_DEPTH=standard          # fast | standard | deep
SEARCH_MAX_RESULTS=5           # results per search (lower = fewer tokens)
SEARCH_SNIPPET_CHARS=500       # chars of page text per result

# --- SendGrid email ---
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=verified-sender@yourdomain.com

# --- Pipeline tuning ---
MAX_STARTUPS=5                 # max startups the discovery agent returns
DEEP_DIVE_CONCURRENCY=2        # parallel deep-dive agents (keep low on free tiers)

# --- Frontend -> backend URL ---
BACKEND_URL=http://localhost:8000
