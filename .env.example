# Copy this file to ".env" and put your own keys in it. Never upload .env to GitHub.

# --- AI model (free): Groq - get a key at https://console.groq.com/keys ---
GROQ_API_KEY=your-groq-key
LLM_MODEL=groq:openai/gpt-oss-120b

# --- Web search: Linkup - get a key at https://app.linkup.so ---
LINKUP_API_KEY=your-linkup-key
LINKUP_DEPTH=standard

# --- How much each search reads (smaller = fewer AI tokens) ---
SEARCH_MAX_RESULTS=5
SEARCH_SNIPPET_CHARS=500
FETCH_MAX_CHARS=3000

# --- Startups per request ---
MAX_STARTUPS=4
MAX_STARTUPS_LIMIT=10

# --- Cost limits (Linkup: search ~$0.005, page read ~$0.001) ---
MAX_SEARCHES_DISCOVERY=4
MAX_SEARCHES_PER_STARTUP=2
MAX_PAGE_READS_PER_STARTUP=1
LINKUP_CACHE=true
CACHE_DIR=.cache

# --- How many startups are researched at the same time (1 = slower but gentler on Groq's limits) ---
DEEP_DIVE_CONCURRENCY=2
